#include <iostream>
#include <vector>
#include <algorithm>
#include <queue>

using namespace std;

// Structure to hold each village's request
struct Request {
    int deadline;
    long long crates;
    
    // Sort requests by deadline in ascending order
    bool operator<(const Request& other) const {
        return deadline < other.deadline;
    }
};

int main() {
    // Optimize standard I/O operations for performance
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);
    
    int n;
    if (!(cin >> n)) return 0;
    
    vector<Request> requests(n);
    for (int i = 0; i < n; ++i) {
        cin >> requests[i].deadline >> requests[i].crates;
    }
    
    // Sort the requests based on their deadlines
    sort(requests.begin(), requests.end());
    
    // Min-heap to keep track of the chosen deliveries
    // It stores the crates, and the smallest element is always at the top
    priority_queue<long long, vector<long long>, greater<long long>> pq;
    
    for (int i = 0; i < n; ++i) {
        // Tentatively add the current request's crates to our schedule
        pq.push(requests[i].crates);
        
        // If the total scheduled deliveries exceed the current deadline,
        // we must discard the one that contributes the least amount of crates
        if (pq.size() > requests[i].deadline) {
            pq.pop();
        }
    }
    
    // Calculate the total successfully delivered crates
    long long max_crates = 0;
    while (!pq.empty()) {
        max_crates += pq.top();
        pq.pop();
    }
    
    cout << max_crates << "\n";
    
    return 0;
}
