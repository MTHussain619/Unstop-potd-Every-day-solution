#include <iostream>
#include <vector>
#include <unordered_set>
#include <algorithm>

using namespace std;

int main() {
    // Optimize standard I/O operations for performance
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);

    int N, K;
    if (!(cin >> N >> K)) return 0;

    unordered_set<int> lights;
    int max_val = 0;
    
    // Read the grid elements
    for (int i = 0; i < N; ++i) {
        int val;
        cin >> val;
        if (val != -1) {
            lights.insert(val);
            max_val = max(max_val, val);
        }
    }

    bool found = false;
    // Iterate outward from K to find the closest symmetric pair
    int limit = max(K, max_val) + 1;
    
    for (int d = 1; d <= limit; ++d) {
        int X = K - d;
        int Y = K + d;
        
        // As per constraints (1 < Light ID Rating), we can stop if X <= 0
        if (X <= 0) {
            break;
        }
        
        // If both equidistant IDs exist in our set, print and terminate
        if (lights.count(X) && lights.count(Y)) {
            cout << X << " " << Y << "\n";
            found = true;
            break;
        }
    }

    // If no symmetrically balanced pair is found, output -1
    if (!found) {
        cout << -1 << "\n";
    }

    return 0;
}
