#include <iostream>
#include <vector>
#include <ext/pb_ds/assoc_container.hpp>
#include <ext/pb_ds/tree_policy.hpp>

using namespace std;
using namespace __gnu_pbds;

// Define an ordered set that stores pairs of integers.
// This allows us to handle duplicate prices by keeping their original indices unique.
typedef tree<
    pair<int, int>,
    null_type,
    less<pair<int, int>>,
    rb_tree_tag,
    tree_order_statistics_node_update>
    ordered_set;

int main() {
    // Fast I/O
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);

    int n;
    if (!(cin >> n)) return 0;

    vector<int> prices(n + 1);
    ordered_set oset;

    // Read initial prices and insert them into the ordered set
    for (int i = 1; i <= n; ++i) {
        cin >> prices[i];
        oset.insert({prices[i], i});
    }

    int q;
    cin >> q;

    // Process queries
    while (q--) {
        char type;
        cin >> type;

        if (type == 'U') {
            int i, v;
            cin >> i >> v;
            // Remove the old price of stall i
            oset.erase({prices[i], i});
            // Update the array
            prices[i] = v;
            // Insert the new price
            oset.insert({prices[i], i});
            
        } else if (type == 'C') {
            int X;
            cin >> X;
            // order_of_key returns the number of elements strictly smaller than the given key.
            // By querying {X + 1, 0}, we count all elements with a price <= X.
            cout << oset.order_of_key({X + 1, 0}) << "\n";
            
        } else if (type == 'K') {
            int k;
            cin >> k;
            // find_by_order is 0-indexed, so the k-th smallest element is at index k - 1
            auto it = oset.find_by_order(k - 1);
            cout << it->first << "\n";
        }
    }

    return 0;
}
