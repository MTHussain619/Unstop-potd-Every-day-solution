#include <iostream>

using namespace std;

int main() {
    // Fast I/O for competitive programming
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);

    int N;
    if (!(cin >> N)) return 0;

    long long unique_id = 0;
    for (int i = 0; i < N; ++i) {
        long long num;
        cin >> num;
        unique_id ^= num; // XOR operation cancels out numbers that appear twice
    }

    cout << unique_id << "\n";

    return 0;
}
